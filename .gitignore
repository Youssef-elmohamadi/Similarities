# ====================================================================
# Quran Similarities Platform - Comprehensive .gitignore
# (.NET Core Backend + React / Vite Frontend + Tooling & Environment)
# ====================================================================

# --------------------------------------------------------------------
# 1. .NET & C# Backend (Build artifacts, bin/obj, Visual Studio / Rider)
# --------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
TestResults/
*.trx
*.coverage
*.coveragexml
*.opencover.xml

# Visual Studio / VS Code / JetBrains Rider user & cache files
.vs/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.DotSettings.user
_ReSharper*/

# Visual Studio Code settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local / Sensitive configuration files (Never commit production credentials)
backend/**/appsettings.*.local.json
backend/**/appsettings.Secrets.json

# NuGet packages & publish artifacts
*.nupkg
*.snupkg
**/packages/
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/
publish/
publish-selfcontained/
*.zip

# --------------------------------------------------------------------
# 2. Frontend (Node.js, React, Vite, TypeScript, PWA)
# --------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dev-dist/
**/dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
**/coverage/

# Vite / PWA generated service worker dev bundles
frontend/public/sw.js
frontend/public/workbox-*.js

# Environment variables & local secrets
.env.local
.env.*.local
*.env
!*.env.example

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------------------
# 3. Testing, Playwright & Verification Artifacts
# --------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
test_*.png
test_search*.png
test_search_logged_in.png

# --------------------------------------------------------------------
# 4. Python (Audit & scratch test scripts)
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.venv/
venv/
env/

# --------------------------------------------------------------------
# 5. Operating System & Editor Files
# --------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux / Vim / Emacs swap and backup files
*~
*.swp
*.swo
*.bak
*.tmp

